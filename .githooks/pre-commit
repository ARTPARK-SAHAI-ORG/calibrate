#!/usr/bin/env bash
# Lint, format-check and type-check staged Python files on every branch, and
# scan staged changes for secrets.
# Additionally run the full test suite when committing to main.

branch=$(git symbolic-ref --short HEAD 2>/dev/null)

staged_py=$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.py$')

if [ -n "$staged_py" ]; then
    if ! command -v uv >/dev/null 2>&1; then
        echo "✗ uv not found on PATH — install uv or run 'ruff check' manually." >&2
        exit 1
    fi

    echo "→ pre-commit: linting staged Python files..."
    if ! echo "$staged_py" | xargs uv run --extra dev ruff check --force-exclude; then
        echo ""
        echo "✗ Lint failed. Commit aborted."
        echo "  Run 'uv run --extra dev ruff check --fix .' to fix what is auto-fixable."
        exit 1
    fi

    if ! echo "$staged_py" | xargs uv run --extra dev ruff format --check --force-exclude; then
        echo ""
        echo "✗ Formatting check failed. Commit aborted."
        echo "  Run 'uv run --extra dev ruff format .' and stage the result."
        exit 1
    fi
    echo "✓ Lint and formatting passed."

    # mypy reads its file list from pyproject.toml, so it always checks the
    # whole package rather than only what is staged.
    echo "→ pre-commit: type-checking..."
    if ! uv run --extra dev mypy; then
        echo ""
        echo "✗ Type check failed. Commit aborted."
        exit 1
    fi
    echo "✓ Type check passed."
fi

if command -v gitleaks >/dev/null 2>&1; then
    echo "→ pre-commit: scanning staged changes for secrets..."
    if ! gitleaks git --staged --redact --no-banner; then
        echo ""
        echo "✗ Possible secret in staged changes. Commit aborted."
        echo "  Remove it, or add an allowlist entry to .gitleaks.toml if it is a placeholder."
        exit 1
    fi
    echo "✓ No secrets found."
fi

if [ "$branch" != "main" ]; then
    exit 0
fi

# Only run tests when staged changes include .py or .json files.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.(py|json)$'; then
    echo "→ pre-commit: no .py or .json changes staged — skipping tests."
    exit 0
fi

echo "→ pre-commit: running tests before committing to main..."

if ! command -v uv >/dev/null 2>&1; then
    echo "✗ uv not found on PATH — install uv or run 'pytest tests/' manually." >&2
    exit 1
fi

if ! uv run --extra dev pytest tests/ -q; then
    echo ""
    echo "✗ Tests failed. Commit aborted."
    echo "  Fix the failures, or run 'git commit --no-verify' to bypass (not recommended on main)."
    exit 1
fi

echo "✓ Tests passed."
